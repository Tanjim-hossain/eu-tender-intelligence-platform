# Keep your existing .env when upgrading. Never commit credentials.
POSTGRES_DB=tendergraph
POSTGRES_USER=tendergraph
POSTGRES_PASSWORD=replace_with_your_local_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Default: retrieved source facts, no LLM request or generation charge.
RAG_PROVIDER=evidence
RAG_RERANK=false
RAG_MAX_CONTEXT_CHARS=40000
RAG_MAX_OUTPUT_TOKENS=800
RAG_TIMEOUT_SECONDS=120

# For local generation, install a local model in Ollama first, then set:
# RAG_PROVIDER=ollama
# RAG_MODEL=<exact-installed-model-tag>
RAG_OLLAMA_URL=http://127.0.0.1:11434

# Paid generation is opt-in: both provider and an account-accessible model
# must be selected explicitly. Never put your real key in this example.
# RAG_PROVIDER=openai
# RAG_MODEL=<model-available-to-your-api-account>
# OPENAI_API_KEY=<your-key>
