# New installations only. Keep your existing .env when updating.
POSTGRES_DB=tendergraph
POSTGRES_USER=tendergraph
POSTGRES_PASSWORD=replace_with_your_own_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Evidence is the default and makes no generation calls.
RAG_PROVIDER=evidence
RAG_MODEL=
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_TIMEOUT_SECONDS=120
RAG_MAX_OUTPUT_TOKENS=800
RAG_MAX_CONTEXT_CHARS=40000
RAG_RERANK=false

# For your already installed local model, set:
# RAG_PROVIDER=ollama
# RAG_MODEL=qwen3:4b-instruct
# OPENAI_API_KEY is only needed when explicitly selecting RAG_PROVIDER=openai.
