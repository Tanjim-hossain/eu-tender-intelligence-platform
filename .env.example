# New installations only: keep your working .env when applying updates.
POSTGRES_DB=tendergraph
POSTGRES_USER=tendergraph
POSTGRES_PASSWORD=replace_with_your_own_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Recommended native Mac demo: installed local model; no paid API required.
RAG_PROVIDER=ollama
RAG_MODEL=qwen3:4b-instruct
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_TIMEOUT_SECONDS=120
RAG_MAX_OUTPUT_TOKENS=800
RAG_MAX_CONTEXT_CHARS=40000
RAG_RERANK=false

# To run without generation, use RAG_PROVIDER=evidence.
# The code's unconfigured default is evidence; the API Docker overlay uses evidence.
# Existing OpenAI adapter is opt-in only; never an automatic fallback.
